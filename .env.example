# ===================== MinerU API 配置 =====================
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4
# 超长 PDF 单次切分阈值（默认 200 页）
MINERU_MAX_PAGES_PER_BATCH=200

# ===================== DeepSeek 模型与接口配置 =====================
LLM_DEFAULT_MODEL=deepseek-flash
VL_MODEL=deepseek-flash
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_TEMPERATURE=0.1

# ===================== 联网搜索配置 (DeepSeek 原生搜索) =====================
WEB_SEARCH_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/v1/tools/search

# 备用 Brave 搜索（可选）
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/llm/context

# ===================== MinIO 对象存储配置 =====================
MINIO_ENDPOINT=192.168.100.133:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===================== 向量模型 (BGE-M3 / Cloudflare) =====================
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_EMBEDDING_MODEL=@cf/baai/bge-m3

# 本地模型路径（若使用本地加载）
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=1

# ===================== Milvus 向量数据库配置 =====================
MILVUS_URL=http://192.168.100.133:19530
CHUNKS_COLLECTION=finance_chunks
ITEM_NAME_COLLECTION=finance_item_names
ENTITY_NAME_COLLECTION=finance_entity_names

# ===================== MongoDB 历史会话配置 =====================
MONGO_URL=mongodb://192.168.100.133:27017
MONGO_DB_NAME=finance_kb

# ===================== 重排序模型配置 (Reranker) =====================
RERANKER_PROVIDER=cloudflare
CF_RERANKER_MODEL=@cf/baai/bge-reranker-base
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ===================== 日志配置 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
